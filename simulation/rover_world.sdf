<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="mech_minds_arena">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 12 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry><material><ambient>0.22 0.24 0.28 1</ambient><diffuse>0.30 0.32 0.36 1</diffuse></material></visual>
      </link>
    </model>

    <!-- 8 Disaster-Zone Debris Obstacles (Red) -->
    <model name="hazard_1"><static>true</static><pose>0.0 2.4 0.25 0 0 0</pose><link name="l"><visual name="v"><geometry><box><size>0.42 0.42 0.5</size></box></geometry><material><ambient>0.9 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material></visual></link></model>
    <model name="hazard_2"><static>true</static><pose>-1.4 3.6 0.25 0 0 0</pose><link name="l"><visual name="v"><geometry><box><size>0.42 0.42 0.5</size></box></geometry><material><ambient>0.9 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material></visual></link></model>
    <model name="hazard_3"><static>true</static><pose>1.4 3.8 0.25 0 0 0</pose><link name="l"><visual name="v"><geometry><box><size>0.42 0.42 0.5</size></box></geometry><material><ambient>0.9 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material></visual></link></model>
    <model name="hazard_4"><static>true</static><pose>-0.4 5.2 0.25 0 0 0</pose><link name="l"><visual name="v"><geometry><box><size>0.42 0.42 0.5</size></box></geometry><material><ambient>0.9 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material></visual></link></model>
    <model name="hazard_5"><static>true</static><pose>1.0 6.0 0.25 0 0 0</pose><link name="l"><visual name="v"><geometry><box><size>0.42 0.42 0.5</size></box></geometry><material><ambient>0.9 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material></visual></link></model>
    <model name="hazard_6"><static>true</static><pose>-1.8 6.6 0.25 0 0 0</pose><link name="l"><visual name="v"><geometry><box><size>0.42 0.42 0.5</size></box></geometry><material><ambient>0.9 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material></visual></link></model>
    <model name="hazard_7"><static>true</static><pose>0.2 7.6 0.25 0 0 0</pose><link name="l"><visual name="v"><geometry><box><size>0.42 0.42 0.5</size></box></geometry><material><ambient>0.9 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material></visual></link></model>
    <model name="hazard_8"><static>true</static><pose>-1.0 8.6 0.25 0 0 0</pose><link name="l"><visual name="v"><geometry><box><size>0.42 0.42 0.5</size></box></geometry><material><ambient>0.9 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material></visual></link></model>

    <!-- 2 Flush Traversable Disaster Ramps (Sloped cleanly along Y-axis with flat center deck) -->
    <model name="ramp_alpha">
      <static>true</static>
      <pose>0.8 2.8 0.0 0 0 0</pose>
      <link name="l">
        <visual name="south_up_slope">
          <pose>0 -0.42 0.09 0.28 0 0</pose>
          <geometry><box><size>0.85 0.65 0.04</size></box></geometry>
          <material><ambient>0.95 0.65 0.05 1</ambient><diffuse>0.95 0.65 0.05 1</diffuse></material>
        </visual>
        <visual name="center_crest">
          <pose>0 0.0 0.18 0 0 0</pose>
          <geometry><box><size>0.85 0.26 0.04</size></box></geometry>
          <material><ambient>0.95 0.65 0.05 1</ambient><diffuse>0.95 0.65 0.05 1</diffuse></material>
        </visual>
        <visual name="north_down_slope">
          <pose>0 0.42 0.09 -0.28 0 0</pose>
          <geometry><box><size>0.85 0.65 0.04</size></box></geometry>
          <material><ambient>0.95 0.65 0.05 1</ambient><diffuse>0.95 0.65 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="ramp_bravo">
      <static>true</static>
      <pose>-0.8 7.0 0.0 0 0 0</pose>
      <link name="l">
        <visual name="south_up_slope">
          <pose>0 -0.42 0.09 0.28 0 0</pose>
          <geometry><box><size>0.85 0.65 0.04</size></box></geometry>
          <material><ambient>0.95 0.65 0.05 1</ambient><diffuse>0.95 0.65 0.05 1</diffuse></material>
        </visual>
        <visual name="center_crest">
          <pose>0 0.0 0.18 0 0 0</pose>
          <geometry><box><size>0.85 0.26 0.04</size></box></geometry>
          <material><ambient>0.95 0.65 0.05 1</ambient><diffuse>0.95 0.65 0.05 1</diffuse></material>
        </visual>
        <visual name="north_down_slope">
          <pose>0 0.42 0.09 -0.28 0 0</pose>
          <geometry><box><size>0.85 0.65 0.04</size></box></geometry>
          <material><ambient>0.95 0.65 0.05 1</ambient><diffuse>0.95 0.65 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Custom Autodesk Fusion CAD Rover (Gravity disabled so it NEVER sinks or bounces!) -->
    <model name="mech_minds_rover">
      <pose>0 0 0.085 0 0 1.5708</pose>
      <link name="chassis">
        <gravity>false</gravity>
        <kinematic>true</kinematic>
        <inertial><mass>4.5</mass><inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz></inertia></inertial>
        <visual name="visual">
          <pose>0 0 0 0 0 -1.5708</pose>
          <geometry>
            <mesh>
              <uri>/mnt/c/mech-minds-rover/simulation/rover_chassis.stl</uri>
              <scale>0.001 0.001 0.001</scale>
            </mesh>
          </geometry>
          <material><ambient>0.1 0.5 0.9 1</ambient><diffuse>0.1 0.5 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
